# Roamigo Production Environment Configuration (never commit .env)

# --- Server & Networking ---
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:8080

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://roamigo:roamigo@127.0.0.1:5432/roamigo?schema=public
TEST_DATABASE_URL=postgresql://roamigo:roamigo@127.0.0.1:5432/roamigo_test?schema=public
SEED_DEMO_DATA=true

# --- Authentication & Security ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-byte-random-secret-in-production
SESSION_TTL_DAYS=14

# --- Multi-Provider AI Configuration ---
# Supported providers: gemini-api | vertex-ai | openai | openai-compatible
# Leave AI_PROVIDER blank to auto-detect from GEMINI_API_KEY, OPENAI_API_KEY, or GCP_PROJECT_ID
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# Legacy / Direct Provider Keys (supported alongside AI_PROVIDER)
GEMINI_API_KEY=
GEMINI_MODEL=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
OPENAI_API_KEY=

# --- Maps & Geocoding (Optional) ---
# MapLibre uses OpenFreeMap / OSM tiles by default. Set GEOCODING_PROVIDER=nominatim for live lookups.
GEOCODING_PROVIDER=curated
GEOCODING_USER_AGENT=Roamigo/1.0

# --- Optional Email & Google OAuth ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@roamigo.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8080/api/auth/google/callback
